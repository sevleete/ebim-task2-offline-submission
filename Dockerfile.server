FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip git && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir --break-system-packages --retries 10 --timeout 300 \
    torch==2.11.0 torchvision==0.26.0 --index-url https://download.pytorch.org/whl/cu128
RUN pip3 install --no-cache-dir --break-system-packages --retries 10 --timeout 300 \
    "lerobot[pi] @ git+https://github.com/huggingface/lerobot.git@bf31dd794ffb4f87380aba3912f64421e8352d3c" \
    pillow
RUN pip3 install --no-cache-dir --break-system-packages --force-reinstall --no-deps \
    torchvision==0.26.0 --index-url https://download.pytorch.org/whl/cu128
WORKDIR /app
COPY deploy/inference/infer_server.py deploy/inference/protocol.py /app/
COPY server/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENV PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1
EXPOSE 6060
ENTRYPOINT ["/entrypoint.sh"]
