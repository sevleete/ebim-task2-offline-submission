FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir --break-system-packages --retries 10 --timeout 300 \
    torch==2.11.0 --index-url https://download.pytorch.org/whl/cu128
RUN pip3 install --no-cache-dir --break-system-packages --retries 10 --timeout 300 \
    lerobot==0.6.2 pillow
WORKDIR /app
COPY deploy/inference/infer_server.py deploy/inference/protocol.py /app/
COPY server/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENV PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1
EXPOSE 6060
ENTRYPOINT ["/entrypoint.sh"]
